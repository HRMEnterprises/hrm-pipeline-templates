<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      GitHub Packages feed for HRM Enterprises.
      NUGET_AUTH_TOKEN is injected at runtime from secrets.GITHUB_TOKEN
      by the reusable workflow â€” do not hardcode credentials here.
    -->
    <add key="github" value="https://nuget.pkg.github.com/HRMEnterprises/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="x-access-token" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
